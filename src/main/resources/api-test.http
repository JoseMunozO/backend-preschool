Content-Type: application/json
Authorization: Bearer {{finance_token}}

{
  "studentId": 1,
  "chargeTypeId": 1,
  "dueDate": "2026-06-05",
  "billingPeriodStart": "2026-06-01",
  "billingPeriodEnd": "2026-06-30",
  "amountDue": 1500.00,
  "status": "PENDING",
  "description": "Cuota mensual junio 2026"
}

> {%
    client.global.set("student_charge_id", response.body.studentChargeId);
%}

