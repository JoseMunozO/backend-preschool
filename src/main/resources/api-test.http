###

### Create cash payment with FINANCE token
POST http://localhost:8080/api/payments
Content-Type: application/json
Authorization: Bearer {{finance_token}}

{
  "parentId": 1,
  "receivedByStaffId": 3,
  "paymentDate": "2026-06-05",
  "totalAmount": 1500.00,
  "paymentMethod": "CASH",
  "referenceNumber": "CASH-JUN-001",
  "notes": "Pago en efectivo registrado desde api-test.http",
  "allocations": [
    {
      "studentChargeId": {{student_charge_id}},
      "amountAllocated": 1500.00
    }
  ]
}

> {%
    client.global.set("payment_id", response.body.paymentId);
%}

###

### Create card payment example with FINANCE token
POST http://localhost:8080/api/payments
Content-Type: application/json
Authorization: Bearer {{finance_token}}

{
  "parentId": 1,
  "receivedByStaffId": 3,
  "paymentDate": "2026-06-06",
  "totalAmount": 500.00,
  "paymentMethod": "CARD",
  "referenceNumber": "CARD-DEMO-001",
  "notes": "Ejemplo de pago con tarjeta. Cambiar studentChargeId antes de ejecutar si el cargo ya esta pagado.",
  "allocations": [
    {
      "studentChargeId": 2,
      "amountAllocated": 500.00
    }
  ]
}

